
{
  "entities": {
    "Personnel": {
      "title": "Personnel",
      "description": "Employee profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "surname": { "type": "string" },
        "fullName": { "type": "string" },
        "tcId": { "type": "string" },
        "birthDate": { "type": "string" },
        "gender": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "address": { "type": "string" },
        "personnelCode": { "type": "string" },
        "registryNo": { "type": "string", "description": "Unique employee registry number" },
        "branchId": { "type": "string" },
        "departmentId": { "type": "string" },
        "position": { "type": "string" },
        "workType": { "type": "string", "enum": ["Office", "Field", "Remote", "Hybrid"] },
        "startDate": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Probation"] },
        "salary": {
          "type": "object",
          "properties": {
            "amount": { "type": "number" },
            "type": { "type": "string", "enum": ["Monthly", "Daily", "Hourly"] },
            "currency": { "type": "string", "enum": ["TRY", "EUR", "USD"] },
            "iban": { "type": "string" },
            "bankName": { "type": "string" },
            "paymentDay": { "type": "number" },
            "advanceLimit": { "type": "number" },
            "overtimeMultiplier": { "type": "number" }
          }
        },
        "role": { "type": "string", "enum": ["Personnel", "Manager", "HR", "Accountant", "Admin"] },
        "hasAdminAccess": { "type": "boolean" },
        "hasMobileAccess": { "type": "boolean" },
        "qrId": { "type": "string" },
        "deviceId": { "type": "string" },
        "cardId": { "type": "string" },
        "faceVerification": { "type": "boolean" },
        "locationVerification": { "type": "boolean" },
        "offlineAccess": { "type": "boolean" },
        "defaultShiftId": { "type": "string" },
        "weeklyHours": { "type": "number" },
        "overtimeAllowed": { "type": "boolean" },
        "avatarUrl": { "type": "string" },
        "emergencyContactName": { "type": "string" },
        "emergencyContactRelation": { "type": "string" },
        "emergencyContactPhone": { "type": "string" },
        "notes": { "type": "string" },
        "isDeleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "surname", "email", "phone", "role", "status"]
    },
    "AttendanceLog": {
      "title": "AttendanceLog",
      "description": "Daily entry and exit logs",
      "type": "object",
      "properties": {
        "personnelId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "entryTime": { "type": "string", "format": "date-time" },
        "exitTime": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "verificationMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["OnTime", "Late", "EarlyDeparture"] },
        "isRemote": { "type": "boolean" },
        "gps": { "type": "string" }
      }
    },
    "Shift": {
      "title": "Shift",
      "description": "Work schedule assignments",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "color": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/personnel/{personnelId}": {
      "schema": "Personnel",
      "description": "Individual personnel records"
    },
    "/attendance_logs/{logId}": {
      "schema": "AttendanceLog",
      "description": "Daily tracking logs"
    },
    "/shifts/{shiftId}": {
      "schema": "Shift",
      "description": "Shift type definitions"
    }
  }
}
